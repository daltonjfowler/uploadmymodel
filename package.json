{
  "name": "uploadmymodel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Classroom web slicer for the LulzBot Workhorse, with teacher-set limits, built for Chromebook classrooms.",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && wrangler dev --enable-containers=false",
    "dev:web": "vite web",
    "build": "vite build web",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test \"test/*.test.mjs\"",
    "icons": "node scripts/make-icons.mjs web/public",
    "test:browser": "node test/browser/run.mjs"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "playwright-core": "1.55.0",
    "vite": "8.2.2",
    "wrangler": "4.142.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15"
  }
}
