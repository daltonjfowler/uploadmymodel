{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uploadmymodel",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  // request.signal fires when a student's browser goes away mid-slice, so the Worker can still give
  // the place in the slicer line back (src/line.js sliceThroughLine).
  "compatibility_flags": ["enable_request_signal"],
  // uploadmymodel.com is the real address; www redirects to it (src/worker.js). The
  // workers.dev URL stays on as a fallback.
  "routes": [
    { "pattern": "uploadmymodel.com", "custom_domain": true },
    { "pattern": "www.uploadmymodel.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "kv_namespaces": [
    // This app's own namespace (title uploadmymodel-CLASS_KV). Never reuse uploadmycode's
    // (CLASS_KV) or uploadmylaser's (uploadmylaser-CLASS_KV).
    { "binding": "CLASS_KV", "id": "348e4cd89f9a4f5da842763149d5d96d" }
  ],
  // TEACHER_KEY is a secret: npx wrangler secret put TEACHER_KEY
  // The slicer: CuraEngine 4.13.2 in a container (container/README.md). 1 vCPU / 3 GiB is the
  // smallest custom size (Cloudflare needs 3 GiB per vCPU; slicing itself peaks at ~300 MiB on the
  // biggest plate): a supported Benchy in about 16 s, five times faster than basic (79 s). More
  // vCPUs barely help (tree supports run on one core: 4 vCPU = 14 s). CPU bills only while
  // slicing; memory while awake. Sleeps after 1 min without work (server.py must exit on SIGTERM
  // for that), and only the teacher's open slicing window lets work in.
  "containers": [
    {
      "class_name": "SlicerContainer",
      "image": "./container/Dockerfile",
      "image_build_context": ".",
      "instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 4000 },
      "max_instances": 3 // SLICERS in src/index.js (2) + 1 for the old cf-singleton-container name (see there)
    }
  ],
  // SLICER_LINE: the line in front of the slicers (src/line.js), its own object so that students
  // asking for their place never touch a container.
  "durable_objects": {
    "bindings": [
      { "name": "SLICER", "class_name": "SlicerContainer" },
      { "name": "SLICER_LINE", "class_name": "SlicerLine" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SlicerContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["SlicerLine"] }
  ],
  // Fair-use fuses (src/worker.js). Namespace ids are unique across the whole Cloudflare account.
  // SLICE_RATE / SLICE_RATE_ALL (slicerBudget): per browser, and for everyone.
  // SLICE_RATE_IP: every /api/slice try per address, counted before the class phrase is checked, so
  //   guessing it is slow. A school shares ONE address: never below SLICE_RATE_ALL (Dalton's rule).
  // API_RATE_IP: /api/slicing, /api/class, /api/slice/line per address. 3000 covers a full line
  //   polling every 2 s (82 pages x 30 a minute = 2460) plus page loads; see handleApi.
  "ratelimits": [
    { "name": "SLICE_RATE", "namespace_id": "20260926", "simple": { "limit": 6, "period": 60 } },
    { "name": "SLICE_RATE_ALL", "namespace_id": "20260927", "simple": { "limit": 60, "period": 60 } },
    { "name": "SLICE_RATE_IP", "namespace_id": "20260950", "simple": { "limit": 60, "period": 60 } },
    { "name": "API_RATE_IP", "namespace_id": "20260951", "simple": { "limit": 3000, "period": 60 } }
  ],
  // public/ is built from web/ by `npm run build` (npm run deploy does it first).
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    // Every response, static files included, goes through the Worker for https + security headers.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
