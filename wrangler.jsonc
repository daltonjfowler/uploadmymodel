{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uploadmymodel",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  // uploadmymodel.com is the real address; www redirects to it (src/worker.js). The
  // workers.dev URL stays on as a fallback.
  "routes": [
    { "pattern": "uploadmymodel.com", "custom_domain": true },
    { "pattern": "www.uploadmymodel.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "kv_namespaces": [
    // This app's own namespace (title uploadmymodel-CLASS_KV). Never reuse uploadmycode's
    // (CLASS_KV) or uploadmylaser's (uploadmylaser-CLASS_KV).
    { "binding": "CLASS_KV", "id": "348e4cd89f9a4f5da842763149d5d96d" }
  ],
  // TEACHER_KEY is a secret: npx wrangler secret put TEACHER_KEY
  // The slicer: CuraEngine 4.13.2 in a container (container/README.md). 1 vCPU / 3 GiB is the
  // smallest custom size (Cloudflare needs 3 GiB per vCPU): a supported Benchy in about 16 s, five
  // times faster than basic (79 s). CPU bills only while slicing; memory while awake. Sleeps
  // after 5 min without work, and only the teacher's open slicing window lets work in.
  "containers": [
    {
      "class_name": "SlicerContainer",
      "image": "./container/Dockerfile",
      "image_build_context": ".",
      "instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 4000 },
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SLICER", "class_name": "SlicerContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SlicerContainer"] }],
  // Fair-use fuse for the slicer (src/worker.js slicerBudget): per browser, and for everyone.
  "ratelimits": [
    { "name": "SLICE_RATE", "namespace_id": "20260926", "simple": { "limit": 6, "period": 60 } },
    { "name": "SLICE_RATE_ALL", "namespace_id": "20260927", "simple": { "limit": 60, "period": 60 } }
  ],
  // public/ is built from web/ by `npm run build` (npm run deploy does it first).
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    // Every response, static files included, goes through the Worker for https + security headers.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
